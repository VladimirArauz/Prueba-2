# =========================================================
# NECUTLA — Apache (IONOS hosting compartido y XAMPP en local)
# Hace lo que hacía server/index.js: direcciones, redirecciones, cabeceras de seguridad y caché.
# La API (/api/* y /healthz) la atiende api/index.php; el código del servidor está fuera, en app/.
# =========================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8
# Página de error con el diseño del sitio (la API responde su propio JSON)
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType image/svg+xml .svg
    AddCharset utf-8 .txt .html .css .js .json .svg
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType image/x-icon .ico
</IfModule>

RewriteEngine On
RewriteBase /

# TRACE y TRACK no se aceptan
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)$
RewriteRule ^ - [R=405,L]

# HTTPS siempre en el servidor de verdad (no en localhost). Solo vale lo que dice Apache (%{HTTPS}):
# la cabecera X-Forwarded-Proto la puede mandar cualquiera, así que no sirve para saltarse la redirección.
# Además, www.necutla.com y la dirección temporal de IONOS van a https://necutla.com, para que la sesión
# (cookie __Host-, una por dirección) y la vista previa de WhatsApp usen siempre la misma.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^necutla\.com$ [NC]
RewriteRule ^ https://necutla.com%{REQUEST_URI} [R=301,L]

# Archivos y carpetas que empiezan con punto no se sirven (.htaccess, .user.ini, .git…), salvo .well-known
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

# La API y la revisión de salud
RewriteRule ^api(/.*)?$ api/index.php [END,QSA]
RewriteRule ^healthz/?$ api/index.php [END,QSA]
# Mapa del sitio para los buscadores (app/sitemap.php): se arma con las tiendas y productos visibles
RewriteRule ^sitemap\.xml$ api/index.php [END,QSA]

# Páginas públicas: PHP pone la vista previa del enlace (Open Graph) de cada una (app/paginas.php).
# Una sola página para todas las tiendas (/t/ropa, /t/tecnologia?sub=cables…) y una para cada producto (/p/12)
RewriteRule ^t/[a-z0-9-]{1,60}/?$ api/index.php [END,QSA]
RewriteRule ^p/[1-9][0-9]{0,9}/?$ api/index.php [END,QSA]
RewriteRule ^(index\.html|carrito\.html|promociones\.html|cuenta\.html|privacidad\.html|terminos\.html)?$ api/index.php [END,QSA]

# Las direcciones de las páginas fijas que había antes siguen funcionando
RewriteRule ^(ropa|tecnologia|dulces|propaganda|papeleria|regalos|otra)/carrito\.html$ /carrito.html [R=301,L]
RewriteRule ^(ropa|tecnologia|dulces|propaganda|papeleria|regalos|otra)(/(index\.html)?)?$ /t/$1 [R=301,L]
RewriteRule ^(ropa|tecnologia|dulces|propaganda|papeleria|regalos|otra)/([a-z0-9-]+)(/(index\.html)?)?$ /t/$1?sub=$2 [R=301,L]

# Ningún otro .php se ejecuta (solo api/index.php)
RewriteCond %{REQUEST_URI} !^/api/index\.php$
RewriteRule \.(php[0-9]?|phtml|phar)$ - [R=404,L]

# Compresión gzip de todo lo que es texto (IONOS la acepta; no tiene brotli). Las imágenes y fuentes ya van comprimidas.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml text/plain image/svg+xml application/manifest+json image/x-icon
</IfModule>

<IfModule mod_headers.c>
    # Cabeceras de seguridad (las mismas que ponía helmet). "always" también las pone en las respuestas de PHP.
    # Plan 2026-10-31-seguridad-turnstile-y-cloudflare-aparte: fuentes propias (/fuentes/), sin Google Fonts;
    # challenges.cloudflare.com = captcha Turnstile (script y su recuadro); cloudflareinsights.com = Web Analytics.
    Header always set Content-Security-Policy "default-src 'self';script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com;script-src-attr 'none';style-src 'self';font-src 'self';img-src 'self' data:;connect-src 'self' https://cloudflareinsights.com;frame-src https://challenges.cloudflare.com;worker-src 'none';manifest-src 'self';object-src 'none';base-uri 'self';form-action 'self';frame-ancestors 'none'"
    Header always set Content-Security-Policy "default-src 'self';script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com;script-src-attr 'none';style-src 'self';font-src 'self';img-src 'self' data:;connect-src 'self' https://cloudflareinsights.com;frame-src https://challenges.cloudflare.com;worker-src 'none';manifest-src 'self';object-src 'none';base-uri 'self';form-action 'self';frame-ancestors 'none';upgrade-insecure-requests" "expr=%{HTTPS} == 'on'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    # Las fotos (públicas; las ocultas dan 404) sí se pueden cargar desde otro sitio: WhatsApp Web arma la vista
    # previa del enlace desde web.whatsapp.com y con "same-origin" el navegador le bloquea la imagen.
    Header always set Cross-Origin-Resource-Policy "cross-origin" "expr=%{CONTENT_TYPE} =~ m#^image/(png|jpeg|webp|gif)#"
    Header always set Origin-Agent-Cluster "?1"
    Header always set X-DNS-Prefetch-Control "off"
    Header always set X-Download-Options "noopen"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set X-XSS-Protection "0"
    # Funciones del navegador que el sitio no usa: apagadas para cualquier script
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # HTML, CSS y JS se revalidan siempre (304 si no cambiaron): si no, tras subir cambios el navegador
    # mezcla el HTML nuevo con el style.css o comun.js viejo de su caché. Lo demás, 1 hora.
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|json|txt|webmanifest)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    # Las fuentes casi nunca cambian: 30 días (si se cambia una, se le cambia el nombre al archivo)
    <FilesMatch "\.woff2?$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Necutools no debe aparecer en buscadores
    <Files "necutools.html">
        Header set X-Robots-Tag "noindex, nofollow"
    </Files>
</IfModule>

# Contacto para reportar fallas de seguridad
<Files "security.txt">
    ForceType "text/plain; charset=utf-8"
</Files>
