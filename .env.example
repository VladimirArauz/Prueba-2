# =========================================================
# NECUTLA — Variables de entorno
# Copia este archivo como .env para desarrollo local:  cp .env.example .env
# En Render, estas variables se configuran en Environment (no se sube .env).
# =========================================================

# development en tu computadora, production en Render
NODE_ENV=development

# Puerto del servidor (Render lo asigna solo; no lo definas allá)
PORT=3000

# Conexión a PostgreSQL
#  - Local:  postgresql://USUARIO:CONTRASEÑA@localhost:5432/necutla
#  - Render: la "Internal Database URL" de tu base (render.yaml la conecta sola)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/necutla

# true si te conectas a una base remota por su "External Database URL" (cifra y verifica el certificado).
# no-verify cifra sin verificar: solo si Node no reconoce el certificado del proveedor.
DATABASE_SSL=false

# Clave para firmar las cookies de sesión: mínimo 32 caracteres aleatorios.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Primer administrador de Necutools. Se crea SOLO si todavía no existe ninguno.
# Contraseña de 12 caracteres o más.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Números de WhatsApp de respaldo: los usan las tiendas que no tienen números propios
# (cada tienda pone los suyos en Necutools). Separados por coma.
# México: 52 + 10 dígitos, sin +, espacios ni guiones.
WHATSAPP_NUMBERS=5255XXXXXXXX,5255XXXXXXXX,5255XXXXXXXX

# Solo para desarrollo: fija la fecha de "hoy" para probar ofertas por día y promociones.
# Formato AAAA-MM-DD. Se ignora cuando NODE_ENV=production.
# HOY_PRUEBA=2026-11-02
